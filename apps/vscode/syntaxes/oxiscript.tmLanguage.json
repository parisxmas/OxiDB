{
  "scopeName": "source.oxiscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.oxiscript", "match": "//.*$" },
        { "name": "comment.block.oxiscript", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.oxiscript", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.oxiscript", "match": "\\\\." }] },
        { "name": "string.quoted.single.oxiscript", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.oxiscript", "match": "\\\\." }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.oxiscript", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.oxiscript", "match": "\\b(proc|let|if|else|return|abort|for|in)\\b" },
        { "name": "constant.language.oxiscript", "match": "\\b(true|false|null)\\b" },
        { "name": "support.type.oxiscript", "match": "\\$(set|unset|inc|mul|min|max|rename|currentDate|push|pull|addToSet|pop|match|group|sort|skip|limit|project|count|unwind|addFields|lookup|out|sum|avg|first|last|eq|ne|gt|gte|lt|lte|in|nin|exists|regex|and|or|not|expr)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.oxiscript", "match": "\\b(find|find_one|insert|update|update_one|delete|delete_one|count|aggregate)\\b(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.oxiscript", "match": "(==|!=|<=|>=|&&|\\|\\||<|>|\\+|-|\\*|/|%|!|=)" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.oxiscript", "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    }
  }
}
