# Copy to `.env` and fill in from the OxiBase dashboard (Open a project → API keys).
# `.env` is gitignored — never commit real keys.
VITE_OXIBASE_URL=http://127.0.0.1:8087
VITE_OXIBASE_REF=your-project-ref
# service_role for this local demo so writes work (anon is read-only over REST).
# In production, keep service_role server-side and use the anon key + rules.
VITE_OXIBASE_KEY=your-service_role-key
