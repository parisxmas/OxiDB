# Copy to `.env` and fill in from the OxiBase dashboard (Open a project → API keys).
# `.env` is gitignored — never commit real keys.
VITE_OXIBASE_URL=http://127.0.0.1:8087
VITE_OXIBASE_REF=your-project-ref
# The browser-safe ANON key (role: read). With a security rule on the collection
# it can read AND write; without one, anon writes are denied by default.
# Run `node setup.mjs` once (with the service_role key) to create that rule.
VITE_OXIBASE_KEY=your-anon-key
