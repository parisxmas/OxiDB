{
  "name": "oxibase-js",
  "version": "0.1.0",
  "description": "Supabase-compatible JavaScript client for OxiBase — createClient(url, key).from('table')... over the PostgREST data plane, plus a .sql() escape hatch to the SQL engine.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/e2e.mjs"
  },
  "keywords": ["oxibase", "oxidb", "supabase", "postgrest", "database", "client"],
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "@supabase/postgrest-js": "^1.19.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
