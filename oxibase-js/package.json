{
  "name": "oxibase-js",
  "version": "0.2.0",
  "description": "JavaScript client for OxiBase — createClient(url, key).from('table')... over the PostgREST data plane, plus .sql(), .subscribe() realtime and .storage.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/refresh.mjs && node test/e2e.mjs",
    "test:offline": "npm run build && node test/refresh.mjs"
  },
  "keywords": ["oxibase", "oxidb", "postgrest", "database", "client"],
  "license": "MIT",
  "homepage": "https://oxidb.baltavista.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parisxmas/OxiDB.git",
    "directory": "oxibase-js"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^1.19.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
