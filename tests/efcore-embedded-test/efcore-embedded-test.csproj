<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../clients/dotnet/OxiDb.EntityFrameworkCore/OxiDb.EntityFrameworkCore.csproj" />
    <!-- The embedded engine: OxiDb.Data reaches it by reflection when the
         connection string says Path=, so the APP references it, not Data. -->
    <ProjectReference Include="../../clients/dotnet/OxiDb.Client.Embedded/OxiDb.Client.Embedded.csproj" />
  </ItemGroup>

  <!-- Via a NuGet reference the runtimes/ layout ships the native library;
       a ProjectReference does not flow it, so the dev-tree build copies the
       locally built one next to the binary. -->
  <ItemGroup>
    <None Include="../../target-local/release/liboxidb_embedded_ffi.dylib"
          Condition="Exists('../../target-local/release/liboxidb_embedded_ffi.dylib')"
          Link="liboxidb_embedded_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
