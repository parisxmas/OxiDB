# Copy to deploy/.env (gitignored) and fill in. NEVER commit real secrets or the
# real host. Generate each secret with:  openssl rand -hex 32

# ── Public host ──────────────────────────────────────────────────────────────
# The server_name nginx answers on, e.g. oxibase.example.com
OXIBASE_HOST=oxibase.example.com
# Public base URL (usually https://<host>) — only used for the informational
# `url` field in project API responses. Leave blank if you don't care.
OXIBASE_PUBLIC_URL=

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Seals per-project/user signing keys. Lives only on the control plane.
OXIDB_SEAL_KEY=
# Signs developer console sessions. Control plane only.
OXIDB_PLATFORM_SECRET=
# Guards the data plane's default-db / native path (project access is ES256).
OXIDB_JWT_SECRET=

# ── Tunables (optional) ──────────────────────────────────────────────────────
# Host port nginx binds. Point your TLS front (Cloudflare origin / SNI
# terminator) at this. Not the public 443.
WEB_PORT=8090
# End-user + developer signup rate limit per minute per IP.
OXIDB_PLATFORM_SIGNUP_RATE=5
# PostgREST read cap.
OXIDB_PGRST_MAX_ROWS=1000
