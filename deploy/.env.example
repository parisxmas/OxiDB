# Copy to deploy/.env (gitignored) and fill in. NEVER commit real secrets or the
# real host. Generate each secret with:  openssl rand -hex 32

# ── Public host ──────────────────────────────────────────────────────────────
# The server_name nginx answers on, e.g. oxibase.example.com
OXIBASE_HOST=oxibase.example.com
# Public base URL (usually https://<host>) — only used for the informational
# `url` field in project API responses. Leave blank if you don't care.
OXIBASE_PUBLIC_URL=

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Seals per-project/user signing keys. Lives only on the control plane.
OXIDB_SEAL_KEY=
# Signs developer console sessions. Control plane only.
OXIDB_PLATFORM_SECRET=
# Guards the data plane's default-db / native path (project access is ES256).
OXIDB_JWT_SECRET=

# ── Developer sign-in — Google (REQUIRED for the dashboard) ──────────────────
# The dashboard signs developers in with "Sign in with Google" only. Create an
# OAuth 2.0 **Web application** client in Google Cloud Console
# (APIs & Services → Credentials), add your public origin (e.g.
# https://oxibase.example.com) under "Authorized JavaScript origins", and paste
# the client ID here. It is a public value (it ships in the browser).
OXIBASE_GOOGLE_CLIENT_ID=

# ── Tunables (optional) ──────────────────────────────────────────────────────
# Host port + bind address nginx listens on. Default binds 127.0.0.1 — put a TLS
# front (Cloudflare origin / your reverse proxy) in front. Set WEB_BIND=0.0.0.0
# to expose directly.
WEB_PORT=8090
WEB_BIND=127.0.0.1
# End-user + developer signup rate limit per minute per IP.
OXIDB_PLATFORM_SIGNUP_RATE=5
# Max projects a single developer account may create (default 100).
OXIDB_PLATFORM_MAX_PROJECTS=100
# Per-project resource quotas (plan-based; written onto each new project row,
# enforced by the data plane at collection/table creation). Default 5.
OXIDB_PROJECT_MAX_COLLECTIONS=5
OXIDB_PROJECT_MAX_TABLES=5
# PostgREST read cap.
OXIDB_PGRST_MAX_ROWS=1000
