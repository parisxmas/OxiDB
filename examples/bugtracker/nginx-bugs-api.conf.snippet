# Add this inside the existing `server { }` block that serves oxidb.baltavista.com
# (the static site). It proxies /bugs-api/* to the bug tracker container, so the
# page at /bugs and its API are same-origin — no CORS, one certificate.
#
# The static page itself is just another file in the exported site (/bugs/), so
# nothing extra is needed to serve it.

location /bugs-api/ {
    proxy_pass         http://127.0.0.1:8124/;   # trailing slash strips the prefix
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
}
