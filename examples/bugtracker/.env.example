# Copy to `.env` (same directory as docker-compose.yml) and fill in.

# REQUIRED. The OAuth 2.0 "Web application" client id from Google Cloud Console.
# The SAME value must be given to the website build as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
BUGS_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Who may close/reopen bugs. Comma-separated emails.
BUGS_ADMIN_EMAILS=barisakin@gmail.com

# Only needed if the site is served from a different origin than production.
# BUGS_ALLOWED_ORIGINS=https://oxidb.baltavista.com,http://localhost:3000
