{
  "name": "oxidb",
  "displayName": "OxiDB",
  "description": "OxiDB document database client — browse collections, run queries, manage indexes",
  "version": "0.1.0",
  "publisher": "oxidb",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{
        "id": "oxidb-explorer",
        "title": "OxiDB",
        "icon": "$(database)"
      }]
    },
    "views": {
      "oxidb-explorer": [{
        "id": "oxidb.collections",
        "name": "Collections"
      }]
    },
    "commands": [
      { "command": "oxidb.connect", "title": "OxiDB: Connect", "icon": "$(plug)" },
      { "command": "oxidb.disconnect", "title": "OxiDB: Disconnect" },
      { "command": "oxidb.refreshCollections", "title": "OxiDB: Refresh", "icon": "$(refresh)" },
      { "command": "oxidb.newQuery", "title": "OxiDB: New Query", "icon": "$(new-file)" },
      { "command": "oxidb.runQuery", "title": "OxiDB: Run Query", "icon": "$(play)" },
      { "command": "oxidb.viewCollection", "title": "View Documents" },
      { "command": "oxidb.dropCollection", "title": "Drop Collection" },
      { "command": "oxidb.createIndex", "title": "Create Index" },
      { "command": "oxidb.insertDocument", "title": "Insert Document" }
    ],
    "menus": {
      "view/title": [
        { "command": "oxidb.connect", "when": "view == oxidb.collections", "group": "navigation" },
        { "command": "oxidb.refreshCollections", "when": "view == oxidb.collections", "group": "navigation" },
        { "command": "oxidb.newQuery", "when": "view == oxidb.collections", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "oxidb.viewCollection", "when": "viewItem == collection" },
        { "command": "oxidb.insertDocument", "when": "viewItem == collection" },
        { "command": "oxidb.createIndex", "when": "viewItem == collection" },
        { "command": "oxidb.dropCollection", "when": "viewItem == collection" }
      ]
    },
    "languages": [{
      "id": "oxiscript",
      "aliases": ["OxiScript"],
      "extensions": [".oxs"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "oxiscript",
      "scopeName": "source.oxiscript",
      "path": "./syntaxes/oxiscript.tmLanguage.json"
    }],
    "configuration": {
      "title": "OxiDB",
      "properties": {
        "oxidb.host": { "type": "string", "default": "127.0.0.1", "description": "Server host" },
        "oxidb.port": { "type": "number", "default": 4444, "description": "Server port" },
        "oxidb.autoConnect": { "type": "boolean", "default": false, "description": "Auto-connect on startup" }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.0.0"
  }
}
