<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OxiDb.EntityFrameworkCore</RootNamespace>

    <PackageId>OxiDb.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core provider for OxiDB document database. Supports both TCP (server) and embedded (in-process) modes.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0-*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OxiDb.Client.Tcp\OxiDb.Client.Tcp.csproj" />
    <ProjectReference Include="..\OxiDb.Client.Embedded\OxiDb.Client.Embedded.csproj" />
  </ItemGroup>

</Project>
