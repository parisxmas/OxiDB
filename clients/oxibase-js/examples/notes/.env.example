# Copy to `.env` and fill in from the OxiBase dashboard (Open a project → API keys).
# `.env` is gitignored — never commit real keys.
VITE_OXIBASE_URL=http://127.0.0.1:8087
VITE_OXIBASE_REF=your-project-ref
# The service_role key (admin) — required because SQL writes are RBAC-gated;
# localhost demos only, NEVER in a shipped browser bundle.

VITE_OXIBASE_KEY=your-service-role-key
