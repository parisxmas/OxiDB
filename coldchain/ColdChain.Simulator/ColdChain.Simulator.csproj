<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- MQTTnet is the ordinary .NET MQTT client. It does not know OxiDB
         exists; it is talking to what it thinks is a normal broker. -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <ProjectReference Include="..\ColdChain.Shared\ColdChain.Shared.csproj" />
  </ItemGroup>
</Project>
