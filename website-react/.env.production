# Baked into the static export at build time. The Google OAuth CLIENT ID is
# public by design (it is the token audience; the sign-in flow validates ID
# tokens against Google's JWKS — there is no secret here). Committing it means
# every `npm run build` produces a working /bugs sign-in without remembering
# to export anything first.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1038597321803-rndmsnj7oa35me005ja1a65ehkhs7ne5.apps.googleusercontent.com
